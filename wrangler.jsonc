{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtlnog-org",
  "compatibility_date": "2026-06-02",
  // Static-assets-only Worker: no server script, just the built site.
  // `directory` replaces the old Pages "build output directory".
  "assets": {
    "directory": "./dist"
  },
  // Contact form submissions. database_id is set when the database is created (see README).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mtlnog-contact",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
}
