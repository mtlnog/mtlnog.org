{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtlnog-org",
  "compatibility_date": "2026-06-02",
  // The script only handles /api/* (contact form) and the cron; every other path is served from dist/.
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Retries undelivered contact submissions and purges old ones.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Contact form submissions. "local" only works with --local: replace it with the id printed by
  // `npx wrangler d1 create mtlnog-contact` before the first deploy (README, "First deploy of the contact form").
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mtlnog-contact",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
}
