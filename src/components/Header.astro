---
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Locale, Strings } from '../i18n/utils';
import { pathFor, inviteHref, type PageKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  strings: Strings;
  page: PageKey;
}

const { locale, strings, page } = Astro.props;

const links: { key: PageKey; label: string }[] = [
  { key: 'meetings', label: strings.nav.meetings },
  { key: 'team', label: strings.nav.team },
  { key: 'sponsorship', label: strings.nav.sponsorship },
];
---
<header>
  <div class="inner-wrap header-inner">
    <a class="logo-link" href={pathFor('home', locale)}>
      <img class="logo-mark" src="/logo.png" alt="MTLNOG logo" width="605" height="147" />
      <div class="logo-text">
        <span>Montreal Network Operator Group</span>
      </div>
    </a>
    <div class="header-actions">
      <nav>
        {links.map((l) => (
          <a
            href={pathFor(l.key, locale)}
            class={l.key === page ? 'active' : undefined}
            aria-current={l.key === page ? 'page' : undefined}
          >{l.label}</a>
        ))}
        <a href={inviteHref(locale)}>{strings.nav.invite}</a>
      </nav>
      <LanguageSwitcher locale={locale} page={page} />
    </div>
  </div>
</header>
