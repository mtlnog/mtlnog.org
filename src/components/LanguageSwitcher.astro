---
import { otherLocale, type Locale } from '../i18n/utils';
import { pathFor, type PageKey } from '../i18n/routes';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const other = otherLocale(locale);
const otherHref = pathFor(page, other);
---
<div class="lang-switch">
  {locale === 'fr'
    ? <span class="active">FR</span>
    : <a href={otherHref} data-lang="fr">FR</a>}
  <span class="sep">·</span>
  {locale === 'en'
    ? <span class="active">EN</span>
    : <a href={otherHref} data-lang="en">EN</a>}
</div>

<script>
  document.querySelectorAll('.lang-switch a[data-lang]').forEach((el) => {
    el.addEventListener('click', () => {
      const lang = el.getAttribute('data-lang');
      if (lang) localStorage.setItem('mtlnog-lang', lang);
    });
  });
</script>
