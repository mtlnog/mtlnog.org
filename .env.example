# Public client-side identifier, injected at build time. It IS visible in the shipped HTML.
# Production uses the MTLNOG Turnstile widget; locally you can use Cloudflare's always-pass
# test sitekey 1x00000000000000000000AA (pair it with the test secret in .dev.vars).
PUBLIC_TURNSTILE_SITEKEY=1x00000000000000000000AA
